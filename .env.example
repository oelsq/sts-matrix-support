# setup.py init generates local passwords. Fill in only your own provider key.
MATRIX_SERVER_NAME=demo.local
ELEMENT_PUBLIC_URL=http://localhost:8081
BIND_ADDRESS=127.0.0.1
ELEMENT_PORT=8081
FRONTEND_PORT=8080
MATRIX_PORT=8008
BACKEND_PORT=8010
POSTGRES_PASSWORD=GENERATE_LOCALLY
MATRIX_BOT_PASSWORD=GENERATE_LOCALLY
LITELLM_MASTER_KEY=GENERATE_LOCALLY
NITEC_API_KEY=
LLM_PROVIDER_BASE_URL=https://llm.nitec.kz/v1
LEGAL_LLM_MODEL=legal-chat
FINANCE_LLM_MODEL=legal-chat
GENERAL_LLM_MODEL=legal-chat
OFFLINE_MODE=0
# For OFFLINE_MODE=1, setup.py automatically includes compose.offline.yml.
# Provision the actual inference server/weights separately; see docs/OFFLINE.md.
LOCAL_LLM_BASE_URL=http://local-model:8000/v1
LOCAL_LLM_MODEL=openai/REPLACE_WITH_SERVED_MODEL
LOCAL_LLM_API_KEY=not-required

# Optional isolated Flowise pilot (compose.flowise.yml)
FLOWISE_PORT=13001

# Native E2EE: include compose.secure.yml, preserve runtime/bot and state_key.
# optional = old rooms work, !лично creates encrypted personal rooms.
# 1 = old rooms become portals; questions are answered in personal rooms only.
MATRIX_E2EE_ENABLED=0
MATRIX_PRIVATE_AI_MODE=optional
HANDOFF_CONTEXT_RETENTION_DAYS=30

# Main specialist rooms use one free model completion by default.
# Use an explicit JSON {"!room:server":"legal"|"finance"} file inside the container.
# Set MATRIX_FREE_REPLY_ROOMS_FILE= to retain legacy/audited routing instead.
# MATRIX_FREE_REPLY_ROOMS_FILE=/app/state/room_routes.json
